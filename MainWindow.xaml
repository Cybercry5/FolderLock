<Window x:Class="FolderLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderLock" Width="540" Height="500" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TabControl Grid.Row="0">
      <TabItem Header="Lock folder">
        <StackPanel Margin="12">
          <TextBlock Text="Folder to lock"/>
          <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,2" Margin="6,0,0,0" Click="BrowseFolder_Click"/>
            <TextBox x:Name="FolderBox"/>
          </DockPanel>
          <TextBlock Text="Password (min 10 characters)"/>
          <PasswordBox x:Name="LockPw" Margin="0,4,0,10"/>
          <TextBlock Text="Confirm password"/>
          <PasswordBox x:Name="LockPw2" Margin="0,4,0,10"/>
          <CheckBox x:Name="HideAfterLock" Content="Also hide the .flock vault file" Margin="0,0,0,14"/>
          <Button x:Name="LockBtn" Content="Lock folder" Padding="12,6" Click="Lock_Click"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Unlock vault">
        <StackPanel Margin="12">
          <TextBlock Text="Vault file (.flock)"/>
          <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,2" Margin="6,0,0,0" Click="BrowseVault_Click"/>
            <TextBox x:Name="VaultBox"/>
          </DockPanel>
          <TextBlock Text="Password"/>
          <PasswordBox x:Name="UnlockPw" Margin="0,4,0,10"/>
          <CheckBox x:Name="DeleteVault" Content="Delete vault file after successful unlock" Margin="0,0,0,14"/>
          <Button x:Name="UnlockBtn" Content="Unlock folder" Padding="12,6" Click="Unlock_Click"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Hide / Unhide">
        <StackPanel Margin="12">
          <TextBlock Text="File or folder to hide"/>
          <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Content="Folder..." Padding="10,2" Margin="6,0,0,0" Click="HideBrowseFolder_Click"/>
            <Button DockPanel.Dock="Right" Content="File..." Padding="10,2" Margin="6,0,0,0" Click="HideBrowseFile_Click"/>
            <TextBox x:Name="HideBox"/>
          </DockPanel>
          <Button Content="Hide" Padding="12,6" Margin="0,0,0,12" Click="Hide_Click"/>
          <TextBlock Text="Items hidden by FolderLock"/>
          <ListBox x:Name="HiddenList" Height="110" Margin="0,4,0,8"/>
          <Button Content="Unhide selected" Padding="12,6" Click="Unhide_Click"/>
          <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0" FontSize="11"
                     Text="Hiding only conceals items from Explorer. It is NOT encryption: anyone can reveal hidden items. For real protection, use Lock folder."/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <ProgressBar x:Name="Busy" Grid.Row="1" Height="6" Margin="0,10,0,6" IsIndeterminate="True" Visibility="Hidden"/>
    <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" MinHeight="32" Text="Ready."/>
  </Grid>
</Window>
